rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidMessage(data) {
      return data.keys().hasAll(['sender', 'content', 'createdAt'])
        && data.sender is string && data.sender.size() > 0 && data.sender.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && data.createdAt is string;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
      allow update: if false;
      allow delete: if false; // Hanya pemilik yang dapat menghapus dokumen langsung lewat Firebase Console
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
